# 复制此文件为 .env 后填入真实凭证：cp .env.example .env
# .env 已在 .gitignore 中（如未加请补上），避免凭证泄露

# ----- MySQL（被同步源）-----
MY_ADDR=mysql:3306
MY_USER=canal
MY_PASS=

# ----- Elasticsearch（同步目标）-----
ES_ADDR=elasticsearch:9200
ES_USER=elastic
ES_PASS=

# ----- 仅 dev profile 使用（开发环境拉起 MySQL/ES）-----
MYSQL_ROOT_PASSWORD=root
